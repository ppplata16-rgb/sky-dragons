# Dominio público con DNS A apuntando al VPS, sin protocolo ni ruta.
DOMAIN=team.example.com

# Genera contraseñas hexadecimales con: openssl rand -hex 32
DB_NAME=sky_dragons
DB_USER=sky_dragons_app
DB_PASS=REEMPLAZAR_CON_UN_SECRETO_HEX
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_OTRO_SECRETO_HEX
# Genera un valor único con: openssl rand -hex 32
JWT_SECRET=REEMPLAZAR_CON_SALIDA_DE_OPENSSL_RAND_HEX_32

# Se crea al primer arranque si la base no contiene usuarios.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_UNICA

# Credenciales OAuth de Concept2 Logbook. La URI de retorno se deriva de DOMAIN.
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONCEPT2_TOKEN_KEY=
